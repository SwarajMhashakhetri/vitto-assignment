# ---- API ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# ---- Postgres (system of record) ----
# Host port is 5433 (see docker-compose.yml) to avoid colliding with a Postgres
# already listening on the default 5432.
DATABASE_URL=postgresql://lds:lds_password@localhost:5433/lending

# ---- MongoDB (append-only audit trail) ----
MONGO_URL=mongodb://localhost:27017/lending_audit

# ---- Redis (BullMQ decision queue) ----
REDIS_URL=redis://localhost:6379

# Artificial delay (ms) in the worker so the async 202 -> poll flow is
# observable in the UI. Set to 0 for instant decisions.
DECISION_PROCESSING_DELAY_MS=1200

# ---- Web (apps/web/.env) ----
VITE_API_URL=http://localhost:4000
