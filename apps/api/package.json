{
  "name": "@lds/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "npm run build --workspace @lds/shared && tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "npm run build --workspace @lds/shared && tsx watch --env-file-if-exists=../../.env src/worker-entry.ts",
    "build": "npm run build --workspace @lds/shared && tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker-entry.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lds/shared": "*",
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.6",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "mongoose": "^8.9.5",
    "pg": "^8.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
