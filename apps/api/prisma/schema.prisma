generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessType {
  RETAIL
  MANUFACTURING
  SERVICES
}

enum ApplicationStatus {
  QUEUED
  PROCESSING
  DECIDED
  FAILED
}

enum DecisionOutcome {
  APPROVED
  REJECTED
}

enum ReasonSeverity {
  CRITICAL
  WARNING
  INFO
  POSITIVE
}

/// The MSME and its owner. PAN is the natural business key, so it is unique:
/// a second application from the same PAN reuses this row rather than
/// creating a duplicate borrower.
model Business {
  id             String       @id @default(uuid())
  ownerName      String       @map("owner_name")
  pan            String       @unique
  businessType   BusinessType @map("business_type")
  /// Money is NUMERIC(14,2) rather than a float. See README "Assumptions" for
  /// why a production system would store minor units as BIGINT instead.
  monthlyRevenue Decimal      @map("monthly_revenue") @db.Decimal(14, 2)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  applications LoanApplication[]

  @@map("businesses")
}

model LoanApplication {
  id              String            @id @default(uuid())
  businessId      String            @map("business_id")
  requestedAmount Decimal           @map("requested_amount") @db.Decimal(14, 2)
  tenureMonths    Int               @map("tenure_months")
  purpose         String
  status          ApplicationStatus @default(QUEUED)
  /// Set when the worker exhausts its retries, so a polling client can be
  /// told the job died instead of waiting forever.
  failureReason   String?           @map("failure_reason")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  decision Decision?

  @@index([businessId])
  @@index([status])
  @@map("loan_applications")
}

/// One decision per application. The unique FK is what makes re-triggering
/// the decision endpoint idempotent.
model Decision {
  id            String          @id @default(uuid())
  applicationId String          @unique @map("application_id")
  outcome       DecisionOutcome
  creditScore   Int             @map("credit_score")
  estimatedEmi  Decimal         @map("estimated_emi") @db.Decimal(14, 2)
  /// Which version of the scorecard produced this row. Stored decisions stay
  /// interpretable after the thresholds are retuned.
  engineVersion String          @map("engine_version")
  evaluatedAt   DateTime        @default(now()) @map("evaluated_at")

  application LoanApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reasons     DecisionReason[]

  @@map("decisions")
}

/// Reason codes are a normalised child table rather than a JSONB blob: they
/// are queryable ("how many rejections cited HIGH_EMI_BURDEN this month?"),
/// which is exactly the question a credit team asks. The unstructured
/// full scoring trace lives in MongoDB instead.
model DecisionReason {
  id           String         @id @default(uuid())
  decisionId   String         @map("decision_id")
  code         String
  severity     ReasonSeverity
  message      String
  pointsImpact Int            @map("points_impact")

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@index([code])
  @@map("decision_reasons")
}
